# HandsRelay v4 — copy to .env and fill in. Never commit .env.

# Token the agent presents to the gateway. Long random string.
# (The hands still use their own per-session generated secret; this gates
# the gateway API only.)
RELAY_GATEWAY_TOKEN=

# Where the gateway reaches the Windows hands (host-native process).
# Default works with Docker Desktop / host-gateway on Linux.
# For native (no-Docker) runs on the same PC: http://127.0.0.1:5000
HANDS_URL=http://host.docker.internal:5000

# For split Docker/native deployments, copy the current secret shown by the
# standalone hands app into this value. The packaged app manages its own
# persistent hands secret and does not need this setting in its own process.
HANDS_SECRET=
